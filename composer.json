    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "view",
        "template",
        "view manager",
        "view engine",
        "render",
        "contract",
        "interface",
        "php",
        "alias",
        "view alias",
        "resolver",
        "pluggable",
        "extensible"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/view-contract/issues",
        "source": "https://github.com/stougeiro/view-contract"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Contract\\View\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    }
}
